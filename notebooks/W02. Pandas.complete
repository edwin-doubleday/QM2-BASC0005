    {
      "cell_type": "markdown",
      "id": "bfcff606",
      "metadata": {
        "id": "bfcff606"
      },
      "source": [
        "Let's break this down. The condition inside the brackets gives `True` or `False` for every row:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "01592ed9",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-10-16T10:39:33.962083Z",
          "iopub.status.busy": "2026-10-16T10:39:33.962031Z",
          "iopub.status.idle": "2026-10-16T10:39:33.964256Z",
          "shell.execute_reply": "2026-10-16T10:39:33.963970Z"
        },
        "id": "01592ed9",
        "outputId": "8f93dc61-7b6d-4779-ecea-ad68458acb6f"
      },
      "outputs": [
        {
          "data": {
            "text/plain": [
              "Percentile Point\n",
              "1     False\n",
              "2     False\n",
              "3     False\n",
              "4     False\n",
              "5     False\n",
              "      ...  \n",
              "95     True\n",
              "96     True\n",
              "97     True\n",
              "98     True\n",
              "99     True\n",
              "Name: Childless couple, annual income, Length: 99, dtype: bool"
            ]
          },
