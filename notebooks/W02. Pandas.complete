        },
        "id": "3733bf4f",
        "outputId": "cf953a4e-efbd-424f-dc62-7958e8b01618"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "(10, 97) -> (960, 3)\n"
          ]
        },
        {
          "data": {
            "text/html": [
